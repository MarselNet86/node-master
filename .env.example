# cdn-deploy configuration contract (tech.md §4). Keep keys, order and defaults in sync.
#
# ./deploy.sh asks for every value and writes .env with mode 600: it holds the Reality
# private key and the SECRET_KEY of the node.
# Values from an existing .env become the defaults on the next run, so copying this file
# to .env and filling it in pre-answers the questions.
#
# Format: KEY=value, one per line. Values are literal: no $ expansion, no escapes.
# Quote values with spaces; " #" after an unquoted value starts a comment.

# Language of the messages: en | ru. ./deploy.sh asks for it first on a terminal; empty
# follows the locale.
UI_LANG=

# Required. FQDN of this server, an A record here: VLESS Reality clients connect to the
# name directly. With CDN_DOMAIN, Let's Encrypt issues its certificate over HTTP-01 (port
# 80 open), and origin nginx serves that certificate to the CDN edge.
VLESS_DOMAIN=

# Optional. FQDN of the Hysteria2 inbound whose certificate this script issues and renews.
# Empty for a profile without Hysteria2, or when the server manages that certificate
# itself: no certificate, no node restart.
HY2_DOMAIN=

# Optional. FQDN of the CDN resource: origin server_name, xhttp host, checker target.
# Empty for a node without the CDN: no xhttp inbound, no origin site of nginx, no reserved
# ports, and the check stops at xray on the node. CDN_DOMAIN, REALITY_SNI and HY2_DOMAIN
# may not all be empty: the profile needs an inbound.
CDN_DOMAIN=

# Required. Public IPv4 of this server: the node address in the panel and the origin of
# the CDN resource. Autodetected with `curl -4 ifconfig.me`, then confirmed.
ORIGIN_IP=

# The CDN settings below are asked and used only with CDN_DOMAIN.
# Local port of the xray xhttp inbound, 1-65535.
XHTTP_PORT=4443

# xhttp path: starts and ends with "/", identical in the inbound and the host config.
# Keep it short with a dot in a segment: Timeweb CDN reportedly returns 403 on long
# URLs and forwards only such paths to origin.
XHTTP_PATH=/api/v2.jpg/

# Port of origin nginx that the CDN edge connects to, 1-65535.
NGINX_TLS_PORT=8444

# Let's Encrypt contact email. Empty registers without an email.
LE_EMAIL=

# Restarts the node in the renewal hook so it picks up the renewed Hysteria2 certificate.
# Used only with HY2_DOMAIN. remnanode is the container name of the official node install.
NODE_RELOAD_CMD="docker restart remnanode"

# Site that the VLESS Reality inbound of the generated config profile impersonates: TLS 1.3
# with h2, close to this server, reachable from Russia. - for a profile without Reality.
REALITY_SNI=www.swiss.com

# Reality x25519 private key, base64url. Generated when empty and kept here, so a rerun
# does not break the clients.
REALITY_PRIVATE_KEY=

# Reality short id: 2 to 16 hex digits. Generated when empty.
REALITY_SHORT_ID=

# Short name of this node, e.g. de1: up to 16 lowercase letters, digits and inner -. The
# inbound tags end with it in capitals (VLESS-REALITY-DE1), as the panel wants every tag
# unique across its profiles, and it names the config profile. Asked with the first
# label of VLESS_DOMAIN as the default.
NODE_NAME=

# Port that the panel reaches the node on: NODE_PORT in the docker-compose.yml that the
# panel shows for the node. Panel step 2 asks for it with NODE_SECRET_KEY.
NODE_PORT=2222

# SECRET_KEY of the node from that docker-compose.yml: base64 of the certificates that tie
# the node to the panel. Panel step 2 asks for it once, after the panel has created the
# node from the rendered profile; ./deploy.sh then writes /opt/remnanode/docker-compose.yml
# and starts the node. Empty without a terminal: the node waits for it.
NODE_SECRET_KEY=
